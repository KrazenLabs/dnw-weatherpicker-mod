<Project Sdk="Microsoft.NET.Sdk" TreatAsLocalProperty="GameDir">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>WeatherPicker</AssemblyName>
    <RootNamespace>WeatherPicker</RootNamespace>
    <Version>1.0.0</Version>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <DebugType>portable</DebugType>
    <!-- Copies the build output into the game's Mods folder after build -->
    <DeployToGame>true</DeployToGame>
  </PropertyGroup>

  <!-- Game folder -->
  <PropertyGroup>
    <GameDir Condition="'$(GameDir)' == '' And '$(DNW_GAME_DIR)' != ''">$(DNW_GAME_DIR)</GameDir>
    <SteamPath Condition="'$(GameDir)' == ''">$([MSBuild]::GetRegistryValueFromView('HKEY_CURRENT_USER\Software\Valve\Steam', 'SteamPath', '', RegistryView.Registry64, RegistryView.Registry32))</SteamPath>
    <SteamGameDir Condition="'$(SteamPath)' != ''">$(SteamPath)/steamapps/common/Drag'n Wash/</SteamGameDir>
    <GameDir Condition="'$(GameDir)' == '' And '$(SteamGameDir)' != '' And Exists('$(SteamGameDir)DragNWash.exe')">$(SteamGameDir)</GameDir>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Drag'n Wash\</GameDir>
    <GameDir Condition="!HasTrailingSlash('$(GameDir)')">$(GameDir)\</GameDir>
    <GameManagedDir>$(GameDir)DragNWash_Data\Managed\</GameManagedDir>
    <GameLoaderDir>$(GameDir)DnWModLoader\</GameLoaderDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="DnWModLoader">
      <HintPath>$(GameLoaderDir)DnWModLoader.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(GameLoaderDir)0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameManagedDir)Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameManagedDir)UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Include="mod.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="DeployToGame" AfterTargets="Build" Condition="'$(DeployToGame)' == 'true' And Exists('$(GameDir)DragNWash.exe')">
    <ItemGroup>
      <_DeployFiles Include="$(OutDir)$(AssemblyName).dll;$(OutDir)$(AssemblyName).pdb;$(OutDir)mod.json" />
    </ItemGroup>
    <Copy SourceFiles="@(_DeployFiles)" DestinationFolder="$(GameDir)Mods\$(AssemblyName)\" SkipUnchangedFiles="true" Condition="Exists('%(FullPath)')" />
    <Message Importance="high" Text="Deployed $(AssemblyName) to $(GameDir)Mods\$(AssemblyName)\" />
  </Target>

</Project>
